# Copiar a `.env` y completar con los valores reales.
# `.env` esta en `.gitignore`: nunca debe subirse al repositorio.

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/sistema_riego

# Clave para firmar los JWT (usar una cadena larga y aleatoria)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar.
# `gemini-1.5-flash` fue retirado de la API. Para ver los vigentes:
#   GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash

# Cuando es True el asesor de IA responde con una respuesta de demostracion
# sin consumir cuota de Gemini.
DEMO_MODE=false
